# OpenAI API key (used for Whisper transcription & GPT-based Japanese translation)
# Generate one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Silence gap threshold used for paragraph breaks (seconds). Defaults to 1.5
PARAGRAPH_GAP_THRESHOLD_SEC=1.5

# Maximum upload size in MB. Defaults to 25 (the Whisper API's own limit)
MAX_UPLOAD_SIZE_MB=25
