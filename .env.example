# OpenAI API key (used for Whisper transcription & GPT-based Japanese translation)
# Generate one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Blob read/write token, used for direct browser-to-storage uploads
# so large MP3 files don't hit Vercel's serverless request body limit.
# When you connect a Blob store to your Vercel project this is injected
# automatically in production/preview. For local development, copy it
# from the Vercel dashboard's Storage tab (or run `vercel env pull`).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Silence gap threshold used for paragraph breaks (seconds). Defaults to 1.5
PARAGRAPH_GAP_THRESHOLD_SEC=1.5

# Maximum upload size in MB. Defaults to 25 (the Whisper API's own limit)
MAX_UPLOAD_SIZE_MB=25
